				rockchip,pins = <0x04 0x0b 0x00 0xd2>;
				phandle = <0xb2>;
			};
		};

		mir3_int {

			mir3-gpio {
				rockchip,pins = <0x00 0x05 0x00 0xcb>;
				phandle = <0xac>;
			};
		};

		aw8680x {

			reset-gpio {
				rockchip,pins = <0x00 0x14 0x00 0xd2>;
				phandle = <0xad>;
			};

			wake-gpio {
				rockchip,pins = <0x00 0x13 0x00 0xd2>;
				phandle = <0xae>;
			};
		};

		lte_pwr_en {

			pwr-en-gpio {
				rockchip,pins = <0x00 0x08 0x00 0xd1>;
				phandle = <0xee>;
			};
		};
	};

	rockchip-suspend {
		compatible = "rockchip,pm-rk3562";
		status = "okay";
		rockchip,sleep-debug-en = <0x01>;
		rockchip,sleep-mode-config = <0x5e2>;
		rockchip,wakeup-config = <0x10>;
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff210000 console=ttyFIQ0";
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x00>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x01>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xf2 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0xd3>;
		status = "okay";
	};

	led_control {
		status = "okay";
		compatible = "led_control";
		debounce-interval = <0x01>;
		wakeup-source;
		pinctrl-names = "default";
		pinctrl-0 = <0xd8 0xd9 0xda>;
		left_gpio = <0x47 0x06 0x01>;
		white-gpio = <0xd6 0x0b 0x00>;
		ir-gpio = <0xd6 0x0c 0x00>;
		hall-down = <0x47 0x12 0x01>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0xdb 0xdc 0xdd>;

		home-key {
			gpios = <0x47 0x04 0x01>;
			linux,code = <0x66>;
			label = "Home Key";
			debounce-interval = <0x19>;
			wakeup-source;
		};

		hall@1 {
			label = "hall-down";
			linux,code = <0x05>;
			linux,input-type = <0x05>;
			gpio = <0x47 0x12 0x01>;
			debounce-interval = <0x32>;
			wakeup-source;
		};

		hall@2 {
			label = "hall-up";
			linux,code = <0x0a>;
			linux,input-type = <0x05>;
			gpio = <0x47 0x07 0x01>;
			debounce-interval = <0x32>;
			wakeup-source;
		};
	};

	charge-animation {
		compatible = "rockchip,uboot-charge";
		rockchip,uboot-charge-on = <0x00>;
		rockchip,android-charge-on = <0x00>;
		rockchip,uboot-low-power-voltage = <0xce4>;
		rockchip,screen-on-voltage = <0xd48>;
		rockchip,auto-wakeup-interval = <0x0a>;
		status = "okay";
	};

	dummy-codec {
		status = "okay";
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0x00>;
	};

	pdm-rk817codec-adc {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,pdm-rk817codec-adc";

		simple-audio-card,cpu {
			sound-dai = <0xde>;
		};

		simple-audio-card,codec {
			sound-dai = <0xdf>;
		};
	};

	aw883x-sound {
		status = "okay";
		compatible = "rockchip,multicodecs-card";
		rockchip,card-name = "rockchip-aw883xx";
		rockchip,format = "i2s";
		rockchip,mclk-fs = <0x100>;
		rockchip,cpu = <0xe0>;
		rockchip,codec = <0xe1>;
	};

	vcc_af_2v8 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <0xe2>;
		regulator-name = "vcc_af_2v8";
		gpio = <0xb1 0x0d 0x00>;
		enable-active-high;
		phandle = <0xba>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x39fbc0>;
		regulator-max-microvolt = <0x39fbc0>;
		phandle = <0x4e>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x0d>;
		wifi_chip_type = "bes2600";
		pinctrl-names = "default";
		pinctrl-0 = <0xe5 0xe6 0xe7>;
		WIFI,host_wake_irq = <0xe8 0x01 0x00>;
		WIFI,poweren_gpio = <0xb0 0x05 0x00>;
		WIFI,host_wakeup_wifi = <0xd6 0x17 0x01>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <0xe3 0x01>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0xd6 0x1b 0x01>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0xe9 0xea>;
		pinctrl-1 = <0xeb>;
		BT,reset_gpio = <0xd6 0x1e 0x00>;
		status = "okay";
	};

	adb_mtp_notify {
		status = "okay";
		compatible = "youdao,usb_device_notify";
		usb-device-name = "adb_mtp";
		extcon = <0xec>;
	};

	serial@ff6a0000 {
		compatible = "rockchip,rk3562-uart", "snps,dw-apb-uart";
		reg = <0x00 0xff6a0000 0x00 0x100>;
		interrupts = <0x00 0x22 0x04>;
		clocks = <0x02 0xbe 0x02 0xa9>;
		clock-names = "baudclk", "apb_pclk";
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		dmas = <0x55 0x04>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0xed 0xee>;
	};

	serial@ff6e0000 {
		compatible = "rockchip,rk3562-uart", "snps,dw-apb-uart";
		reg = <0x00 0xff6e0000 0x00 0x100>;
		interrupts = <0x00 0x26 0x04>;
		clocks = <0x02 0xce 0x02 0xad>;
		clock-names = "baudclk", "apb_pclk";
		reg-shift = <0x02>;
		reg-io-width = <0x04>;
		dmas = <0x55 0x08>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <0xef>;
	};
};
